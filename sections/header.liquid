<header class="fixed top-0 inset-x-0 z-50 bg-white text-black py-6 transition-opacity duration-500">
  <div class="flex flex-row justify-between items-start px-4">
    
    {%- comment -%} NAV GAUCHE {%- endcomment -%}
    <nav class="flex w-1/2 flex-col items-start space-y-2">
      {% for link in linklists.main-menu.links %}
        <div class="w-full">
          <div class="flex items-center justify-between w-1/4">
            <a 
              href="{{ link.url }}" 
              class="text-3xl font-medium hover:text-yellow-400 transition-colors duration-200"
            >
              {{ link.title }}
            </a>

            {% if link.links.size > 0 %}
              <button 
                class="toggle-submenu text-3xl font-bold px-2 focus:outline-none"
                aria-label="Afficher le sous-menu"
              >
                ▾
              </button>
            {% endif %}
          </div>

          {% if link.links.size > 0 %}
            <div class="submenu hidden flex flex-col ml-4 mt-2 space-y-2">
              {% for sublink in link.links %}
                <a 
                  href="{{ sublink.url }}" 
                  class="text-3xl hover:text-yellow-400 transition-colors duration-200"
                >
                  {{ sublink.title }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    {%- comment -%} BLOC DROITE (STORE + LOGIN) {%- endcomment -%}
    <div class="w-1/2 flex justify-end">
      <div class="flex flex-row items-center gap-4 pr-6">
        
        {%- comment -%} BLOC BOUTON STORE {%- endcomment -%}
        <div class="flex">
          <a
            href="{{ routes.cart_url }}"
            class="btn-wave inline-flex items-center justify-center h-16 px-6 rounded-md text-3xl tracking-[0.08em] uppercase font-semibold bg-black text-white"
          >
            <span class="btn-wave-content inline-flex items-center gap-3">
              <!-- Icône sac luxe -->
              <span class="inline-flex items-center justify-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="w-[22px] h-[22px] fill-current"
                  aria-hidden="true"
                >
                  <path d="M7 7V6a5 5 0 0110 0v1h2a1 1 0 01.99 1.141l-1.5 11A1 1 0 0116.5 20h-9a1 1 0 01-.99-.859l-1.5-11A1 1 0 016 7h1zm2 0h6V6a3 3 0 00-6 0v1z"/>
                </svg>
              </span>
              <span>STORE</span>
            </span>
          </a>
        </div>

        {%- comment -%} BLOC BOUTON LOGIN / ACCOUNT {%- endcomment -%}
        <div class="flex">
          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a
                href="{{ routes.account_url }}"
                class="btn-wave inline-flex items-center justify-center w-16 h-16 rounded-md border border-black bg-white text-black"
                aria-label="Mon compte"
              >
                <span class="btn-wave-content inline-flex items-center justify-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-[42px] h-[42px] fill-current"
                    aria-hidden="true"
                  >
                    <path d="M12 12a4 4 0 100-8 4 4 0 000 8zm-7 7a7 7 0 0114 0H5z"/>
                  </svg>
                </span>
              </a>
            {% else %}
              <a
                href="{{ routes.account_login_url }}"
                class="btn-wave inline-flex items-center justify-center w-16 h-16 rounded-md border border-black bg-white text-black"
                aria-label="Se connecter"
              >
                <span class="btn-wave-content inline-flex items-center justify-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-[42px] h-[42px] fill-current"
                    aria-hidden="true"
                  >
                    <path d="M12 12a4 4 0 100-8 4 4 0 000 8zm-7 7a7 7 0 0114 0H5z"/>
                  </svg>
                </span>
              </a>
            {% endif %}
          {% endif %}
        </div>

      </div>
    </div>

  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const buttons = document.querySelectorAll(".toggle-submenu");
    buttons.forEach(button => {
      button.addEventListener("click", () => {
        const submenu = button.parentElement.nextElementSibling;
        submenu.classList.toggle("hidden");
        button.textContent = submenu.classList.contains("hidden") ? "▾" : "▴";
      });
    });
  });
</script>

<header 
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 bg-transparent text-black py-6 transition-opacity duration-500 sm:header-hidden"
>
  {%- comment -%} --- BARRE MOBILE (XS / SM) --- {%- endcomment -%}
  
  <div class="md:hidden flex items-center justify-between px-4">
    {%- comment -%} Bouton tiroir gauche {%- endcomment -%}
    <button
      id="mobile-menu-toggle"
      class="inline-flex items-center justify-center w-12 h-12"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <span class="sr-only">Menu</span>
      <span class="flex flex-col space-y-1">
        <span class="block w-6 h-[2px] bg-black"></span>
        <span class="block w-6 h-[2px] bg-black"></span>
        <span class="block w-6 h-[2px] bg-black"></span>
      </span>
    </button>

    {%- comment -%} Icône compte droite {%- endcomment -%}
    <div class="flex items-center">
      {% if shop.customer_accounts_enabled %}
        {% if customer %}
          <a
            href="{{ routes.account_url }}"
            class="inline-flex items-center justify-center w-12 h-12 text-black"
            aria-label="Mon compte"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-7 h-7 fill-current"
              aria-hidden="true"
            >
              <path d="M12 12a4 4 0 100-8 4 4 0 000 8zm-7 7a7 7 0 0114 0H5z"/>
            </svg>
          </a>
        {% else %}
          <a
            href="{{ routes.account_login_url }}"
            class="inline-flex items-center justify-center w-12 h-12 text-black"
            aria-label="Se connecter"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="w-7 h-7 fill-current"
              aria-hidden="true"
            >
              <path d="M12 12a4 4 0 100-8 4 4 0 000 8zm-7 7a7 7 0 0114 0H5z"/>
            </svg>
          </a>
        {% endif %}
      {% endif %}
    </div>
  </div>

  {%- comment -%} --- HEADER DESKTOP --- {%- endcomment -%}
  <div class="hidden md:!flex flex-row justify-between items-start px-4">    
    {%- comment -%} NAV GAUCHE {%- endcomment -%}
    <nav class="flex w-1/2 flex-col items-start space-y-2">
      {% for link in linklists.main-menu.links %}
        <div class="w-full">
          <div class="flex items-center justify-start">
            <a 
              href="{{ link.url }}" 
              class="text-xl font-medium link-wave"
            >
              {{ link.title }}
            </a>

            {% if link.links.size > 0 %}
              <button 
                class="toggle-submenu text-xl font-bold px-2 focus:outline-none"
                aria-label="Afficher le sous-menu"
              >
                ▾
              </button>
            {% endif %}
          </div>

          {% if link.links.size > 0 %}
            <div class="submenu hidden flex flex-col ml-4 mt-2 space-y-2">
              {% for sublink in link.links %}
                <a 
                  href="{{ sublink.url }}" 
                  class="text-xl link-wave"
                >
                  {{ sublink.title }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>

    {%- comment -%} BLOC DROITE (STORE + LOGIN) {%- endcomment -%}
    <div class="w-1/2 flex justify-end">
      <div class="flex flex-row items-center gap-4">
        
        {%- comment -%} BLOC BOUTON STORE {%- endcomment -%}
        <div class="flex">
          <a
            href="{{ routes.cart_url }}"
            class="btn-wave inline-flex items-center justify-center h-16 px-6 rounded-md text-xl tracking-[0.08em] uppercase font-semibold bg-black text-white"
          >
            <span class="btn-wave-content inline-flex items-center gap-3">
              <span class="inline-flex items-center justify-center">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  class="w-[22px] h-[22px] fill-current"
                  aria-hidden="true"
                >
                  <path d="M7 7V6a5 5 0 0110 0v1h2a1 1 0 01.99 1.141l-1.5 11A1 1 0 0116.5 20h-9a1 1 0 01-.99-.859l-1.5-11A1 1 0 016 7h1zm2 0h6V6a3 3 0 00-6 0v1z"/>
                </svg>
              </span>
              <span>STORE</span>
            </span>
          </a>
        </div>

        {%- comment -%} BLOC BOUTON LOGIN / ACCOUNT {%- endcomment -%}
        <div class="flex">
          {% if shop.customer_accounts_enabled %}
            {% if customer %}
              <a
                href="{{ routes.account_url }}"
                class="btn-wave inline-flex items-center justify-center w-16 h-16 rounded-md border border-black bg-white text-black"
                aria-label="Mon compte"
              >
                <span class="btn-wave-content inline-flex items-center justify-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-[42px] h-[42px] fill-current"
                  >
                    <path d="M12 12a4 4 0 100-8 4 4 0 000 8zm-7 7a7 7 0 0114 0H5z"/>
                  </svg>
                </span>
              </a>
            {% else %}
              <a
                href="{{ routes.account_login_url }}"
                class="btn-wave inline-flex items-center justify-center w-16 h-16 rounded-md border border-black bg-white text-black"
                aria-label="Se connecter"
              >
                <span class="btn-wave-content inline-flex items-center justify-center">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    class="w-[42px] h-[42px] fill-current"
                  >
                    <path d="M12 12a4 4 0 100-8 4 4 0 000 8zm-7 7a7 7 0 0114 0H5z"/>
                  </svg>
                </span>
              </a>
            {% endif %}
          {% endif %}
        </div>

      </div>
    </div>

  </div>

  {%- comment -%} --- TIROIR MOBILE PLEIN ÉCRAN --- {%- endcomment -%}
  <div
    id="mobile-drawer"
    class="fixed inset-0 z-40 bg-white md:hidden transform -translate-x-full transition-transform duration-300 ease-in-out"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between px-4 pt-6">
      <span class="text-xl font-semibold tracking-[0.12em] uppercase">
        Menu
      </span>
      <button
        id="mobile-menu-close"
        class="inline-flex items-center justify-center w-10 h-10 border border-black rounded-full"
        aria-label="Fermer le menu"
      >
        <span class="text-2xl leading-none">&times;</span>
      </button>
    </div>

    <nav class="mt-8 px-4 flex flex-col space-y-6">
      {% for link in linklists.main-menu.links %}
        <div>
          <div class="flex items-center justify-between">
            <a 
              href="{{ link.url }}" 
              class="text-xl font-medium link-wave"
            >
              {{ link.title }}
            </a>

            {% if link.links.size > 0 %}
              <button 
                class="toggle-submenu text-xl font-bold px-2 focus:outline-none"
                aria-label="Afficher le sous-menu"
              >
                ▾
              </button>
            {% endif %}
          </div>

          {% if link.links.size > 0 %}
            <div class="submenu hidden flex flex-col ml-4 mt-2 space-y-2">
              {% for sublink in link.links %}
                <a 
                  href="{{ sublink.url }}" 
                  class="text-2xl link-wave"
                >
                  {{ sublink.title }}
                </a>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </nav>
  </div>
</header>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    // Sous-menus (desktop + mobile)
    const buttons = document.querySelectorAll(".toggle-submenu");
    buttons.forEach(button => {
      button.addEventListener("click", () => {
        const submenu = button.parentElement.nextElementSibling;
        if (!submenu) return;
        submenu.classList.toggle("hidden");
        button.textContent = submenu.classList.contains("hidden") ? "▾" : "▴";
      });
    });

    // Tiroir mobile
    const drawer = document.getElementById("mobile-drawer");
    const openBtn = document.getElementById("mobile-menu-toggle");
    const closeBtn = document.getElementById("mobile-menu-close");

    function openDrawer() {
      drawer.classList.remove("-translate-x-full");
      drawer.classList.add("translate-x-0");
      drawer.setAttribute("aria-hidden", "false");
      if (openBtn) openBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }

    function closeDrawer() {
      drawer.classList.add("-translate-x-full");
      drawer.classList.remove("translate-x-0");
      drawer.setAttribute("aria-hidden", "true");
      if (openBtn) openBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    if (openBtn && drawer) {
      openBtn.addEventListener("click", openDrawer);
    }
    if (closeBtn && drawer) {
      closeBtn.addEventListener("click", closeDrawer);
    }

    // Fermer le menu quand on clique sur un lien du tiroir
    if (drawer) {
      drawer.querySelectorAll("a").forEach(link => {
        link.addEventListener("click", closeDrawer);
      });
    }
  });
</script>

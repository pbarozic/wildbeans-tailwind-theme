<div class="fixed bottom-0 left-0 w-screen z-40">
  <div class="mx-auto max-w-7xl flex items-end justify-between px-4 md:px-8 py-4 pointer-events-none">

    {%- comment -%} LOGO GAUCHE {%- endcomment -%}
    <div class="pointer-events-auto">
      {% if section.settings.image != blank %}
        <img 
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image_alt | escape }}"
          class="w-24 md:w-32 lg:w-40"
        >
      {% endif %}
    </div>

    {%- comment -%} BOUTON DROITE {%- endcomment -%}
    {% if section.settings.button_label != blank and section.settings.button_url != blank %}
      <div class="pointer-events-auto hidden sm:flex">
        <a
          href="{{ section.settings.button_url }}"
          class="inline-flex items-center justify-center px-6 md:px-8 py-2 md:py-3 border border-black text-[0.65rem] md:text-xs lg:text-sm font-semibold tracking-[0.25em] uppercase bg-white text-black rounded-full hover:bg-black hover:text-white transition-colors duration-300"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "WB - Footer Logo + CTA",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Description de l'image (accessibilité & SEO)",
      "default": "Logo Wild Beans"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "PRÉPAREZ VOTRE ÉVÉNEMENT"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "WB - Footer Logo + CTA"
    }
  ]
}
{% endschema %}

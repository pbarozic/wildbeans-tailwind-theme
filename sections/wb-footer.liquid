<div 
id="site-footer"
class="hidden sm:!block fixed bottom-0 left-0 right-0 z-40 bg-transparent wb-footer">
  <div class="flex flex-row justify-between">

    {%- comment -%} LOGO GAUCHE {%- endcomment -%}
    <div class="w-1/3 flex items-center sm:reveal sm:reveal-left">
  {% if section.settings.image != blank %}
    <a href="/" class="block w-full">
      <img
        src="{{ section.settings.image | image_url: width: 800 }}"
        alt="{{ section.settings.image_alt | escape }}"
        class="w-full object-contain"
      >
    </a>
  {% endif %}
</div>


    {%- comment -%} BOUTON DROITE {%- endcomment -%}
    <div id="footer-cta" class="w-2/3 flex items-end justify-end pr-6 mb-6 footer-cta">
      {% if section.settings.button_label != blank %}
       <a
  href="{{ section.settings.button_link | default: '/pages/contact' }}"
  class="btn-wave inline-flex items-center justify-center px-6 py-2 border border-black rounded-md text-xl tracking-[0.08em] uppercase font-semibold bg-black text-white transition-colors duration-300"
>
  <span class="btn-wave-content inline-flex items-center gap-2">
    <span>{{ section.settings.button_label }}</span>
    <span class="inline-block text-xl">↗</span>
  </span>
</a>
      {% endif %}
    </div>

  </div>
</div>
<style>
.footer-cta {
  opacity: 0;
  transform: translateX(40px);
  pointer-events: none;
}

/* Animation quand visible */
.footer-cta--visible {
  animation: footerCtaIn 1s ease forwards;
  animation-delay: 1s;
  pointer-events: auto;
}

@keyframes footerCtaIn {
  from {
    opacity: 0;
    transform: translateX(128px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}
</style>

{% if template.name == 'index' or request.path contains '/pages/events' %}
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const footerCta = document.getElementById('footer-cta');
      if (!footerCta) return;

      const zones = document.querySelectorAll('.barista-button');
      if (!zones.length) return;

      // 1. **Initialisation de l'état de suivi**
      // On utilise un Map pour stocker l'état (true/false) de chaque zone observée
      const visibleZones = new Map();
      zones.forEach((zone, index) => {
          // On donne un ID unique si l'élément n'en a pas
          zone.dataset.observerId = `zone-${index}`; 
          visibleZones.set(zone.dataset.observerId, false);
      });

      const observer = new IntersectionObserver((entries) => {
        let isAnyVisible = false;

        // 2. **Mise à jour de l'état de suivi**
        entries.forEach(entry => {
          const zoneId = entry.target.dataset.observerId;
          
          if (entry.isIntersecting) {
            // La zone entre dans la vue
            visibleZones.set(zoneId, true);
          } else {
            // La zone sort de la vue
            visibleZones.set(zoneId, false);
          }
        });
        
        // 3. **Vérification de l'état global**
        // On vérifie si n'importe quelle valeur dans la Map est 'true'
        for (const isVisible of visibleZones.values()) {
            if (isVisible) {
                isAnyVisible = true;
                break;
            }
        }
        
        // 4. **Application de la classe**
        if (isAnyVisible) {
          footerCta.classList.add('footer-cta--visible');
        } else {
          footerCta.classList.remove('footer-cta--visible');
        }

      }, {
        // threshold: 0.3
        // Utiliser 'rootMargin' est souvent plus stable pour ce type d'effet
        // Il étend la zone de vision (root) de 0 pixels dans les 4 directions
        rootMargin: '0px', 
        threshold: 0.01 // Déclenchement dès qu'un pixel est visible
      });

      // **Déclenchement de l'observation**
      zones.forEach(zone => observer.observe(zone));
      
      // 5. **Correction de l'état initial (au chargement)**
      // On déclenche l'observateur manuellement une fois au début pour définir l'état initial correct
      // (Optionnel mais recommandé pour les Intersection Observers)
      observer.takeRecords().forEach(entry => {
        const zoneId = entry.target.dataset.observerId;
        if (entry.isIntersecting) {
            visibleZones.set(zoneId, true);
        }
      });
      // Et on applique la classe après la vérification initiale
      let initialVisible = false;
      for (const isVisible of visibleZones.values()) {
          if (isVisible) {
              initialVisible = true;
              break;
          }
      }
      if (initialVisible) {
        footerCta.classList.add('footer-cta--visible');
      }

    });
  </script>
{% endif %}

{% schema %}
{
  "name": "WB - Footer Simple",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif",
      "default": "Logo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "RÉSERVER UN BARISTA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "WB - Footer Simple"
    }
  ]
}
{% endschema %}

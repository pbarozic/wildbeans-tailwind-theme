<div 
id="site-footer"
class="fixed bottom-0 left-0 right-0 z-40 bg-transparent wb-footer">
  <div class="flex flex-row justify-between">

    {%- comment -%} LOGO GAUCHE {%- endcomment -%}
    <div class="w-1/3 flex items-center">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          alt="{{ section.settings.image_alt | escape }}"
          class="w-full object-contain"
        >
      {% endif %}
    </div>

    {%- comment -%} BOUTON DROITE {%- endcomment -%}
    <div class="w-2/3 flex items-end justify-end pr-6 mb-6">
      {% if section.settings.button_label != blank %}
       <a
  href="{{ section.settings.button_link | default: routes.contact_url }}"
  class="btn-wave inline-flex items-center justify-center px-6 py-2 border border-black rounded-md text-3xl tracking-[0.08em] uppercase font-semibold bg-black text-white transition-colors duration-300"
>
  <span class="btn-wave-content inline-flex items-center gap-2">
    <span>{{ section.settings.button_label }}</span>
    <span class="inline-block text-3xl">↗</span>
  </span>
</a>
      {% endif %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "WB - Footer Simple",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Logo"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif",
      "default": "Logo"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton",
      "default": "RÉSERVER UN BARISTA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    }
  ],
  "presets": [
    {
      "name": "WB - Footer Simple"
    }
  ]
}
{% endschema %}

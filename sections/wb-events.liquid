{% comment %}
  WB - Events
  Page events avec animations Story + slider Story
{% endcomment %}
<div id="wild-beans-events" class="wild-beans-vertical-slider w-screen h-screen overflow-y-scroll">

<section class="w-full sm:min-h-screen overflow-x-hidden snap-start relative js-events-video">
  <div class="w-full h-full barista-button">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="w-full h-full object-cover"
    >
      <source src="{{ 'V03.MOV' | file_url }}" type="video/mp4" />
      Votre navigateur ne supporte pas la lecture de vidéo.
    </video>
  </div>

  <!-- OVERLAY TEXTE ANIMÉ -->
  <div
    class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center
           -translate-y-[8vh] px-4 text-center"
  >
    <h1
      id="hero-title"
      class="text-white font-bold
             text-[12vw] sm:text-[9vw] md:text-[7vw]
             leading-none tracking-tight
             drop-shadow-[0_0_25px_rgba(255,199,120,0.25)]
drop-shadow-[0_20px_55px_rgba(0,0,0,1)]
"
    ></h1>

    <p
      id="hero-subtitle"
      class="mt-4 text-white/80 text-4xl 
  tracking-[0.25em] uppercase
  drop-shadow-[0_0_25px_rgba(255,199,120,0.25)]
drop-shadow-[0_20px_55px_rgba(0,0,0,1)]"
"
    ></p>
  </div>
</section>

  {% for block in section.blocks %}
    <section
      id="event-{{ block.id }}"
      class="sm:w-2/3 h-screen flex items-center js-safe-layout barista-button snap-start"
    >

      <div class="w-full max-w-[1400px] px-4 grid grid-cols-1 sm:grid-cols-2 gap-10">

        <!-- IMAGE -->
        <div
          class="opacity-0 translate-y-6 will-change-transform
                 transition-all duration-[2000ms] ease-[cubic-bezier(0.19,1,0.22,1)]"
          data-scroll-fade
          style="transition-delay:1000ms;"
        >
          {% if block.settings.image != blank %}
            <div class="w-full h-[420px] overflow-hidden rounded-2xl shadow-lg">
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt="{{ block.settings.image_alt }}"
                class="w-full h-full object-cover"
              >
            </div>
          {% endif %}
        </div>

        <!-- TEXTE -->
        <div
          class="opacity-0 translate-y-6 will-change-transform
                 transition-all duration-[2000ms] ease-[cubic-bezier(0.19,1,0.22,1)]"
          data-scroll-fade
          style="transition-delay:700ms;"
        >
          <div class="rte">
            {{ block.settings.text_html }}
          </div>
        </div>

      </div>

    </section>
  {% endfor %}

</div>

<style>
  .wb-letter {
    opacity: 0;
    transform: translateY(14px);
    display: inline-block;
    animation: wbFadeUp 0.9s forwards ease-out;
  }

  @keyframes wbFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const titleText = "ELEVATE YOUR EVENTS";
    const subtitleText = "Where Premium Coffee Meets Flawless Service";

    const titleEl = document.getElementById("hero-title");
    const subtitleEl = document.getElementById("hero-subtitle");

    function animateText(el, text, baseDelay) {
      if (!el) return;
      el.innerHTML = "";
      Array.from(text).forEach((char, index) => {
        const span = document.createElement("span");
        span.className = "wb-letter";
        span.textContent = char === " " ? "\u00A0" : char;
        span.style.animationDelay = (baseDelay + index * 0.08) + "s";
        el.appendChild(span);
      });
    }

    animateText(titleEl, titleText, 0.08);
    animateText(subtitleEl, subtitleText, 0.8);

    // === ANIMATIONS D'APPARITION AU SCROLL ===
    const fadeEls = document.querySelectorAll("[data-scroll-fade]");

    if (!("IntersectionObserver" in window)) {
      // Fallback vieux navigateurs : on montre tout
      fadeEls.forEach(el => {
        el.classList.remove("opacity-0", "translate-y-6");
      });
      return;
    }

    const fadeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.remove("opacity-0", "translate-y-6");
            // Optionnel : s'assurer de l'état final
            entry.target.classList.add("opacity-100", "translate-y-0");
            // On peut arrêter d'observer une fois l'anim jouée
            fadeObserver.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.2 // l’élément commence à s’animer quand ~20% est visible
      }
    );

    fadeEls.forEach(el => fadeObserver.observe(el));
  });
</script>

{% schema %}
{
  "name": "WB - Events",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Event",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Description image" },
        { "type": "textarea", "id": "text_html", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    { "name": "WB - Events" }
  ]
}

{% endschema %}
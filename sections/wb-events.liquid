{% comment %}
  WB - Events
  Page events avec animations Story + slider Story
{% endcomment %}

<section
  id="wild-beans-events"
  class="w-screen h-screen overflow-y-scroll"
>
  {% for block in section.blocks %}
    <section
      id="event-{{ block.id }}"
      class="sm:w-2/3 min-h-screen flex items-center js-safe-layout barista-button"
    >

      <div class="w-full max-w-[1400px] px-4 grid grid-cols-1 sm:grid-cols-2 gap-10">

        <!-- IMAGE -->
        <div
          class="opacity-0 translate-y-6 will-change-transform
                 transition-all duration-[1900ms] ease-[cubic-bezier(0.19,1,0.22,1)]"
          data-scroll-fade
          style="transition-delay:500ms;"
        >
          {% if block.settings.image != blank %}
            <div class="w-full h-[420px] overflow-hidden rounded-2xl shadow-lg">
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt="{{ block.settings.image_alt }}"
                class="w-full h-full object-cover"
              >
            </div>
          {% endif %}
        </div>

        <!-- TEXTE -->
        <div
          class="opacity-0 translate-y-6 will-change-transform
                 transition-all duration-[2000ms] ease-[cubic-bezier(0.19,1,0.22,1)]"
          data-scroll-fade
          style="transition-delay:200ms;"
        >
          <div class="rte">
            {{ block.settings.text_html }}
          </div>
        </div>

      </div>

    </section>
  {% endfor %}
</section>


{% schema %}
{
  "name": "WB - Events",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Event",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Description image" },
        { "type": "textarea", "id": "text_html", "label": "Texte" }
      ]
    }
  ],
  "presets": [
    { "name": "WB - Events" }
  ]
}

{% endschema %}
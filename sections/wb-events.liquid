{% comment %}
  WB - Events
  Page events avec plusieurs slides qui reprennent la structure de wb-features
{% endcomment %}

<section
  id="wild-beans-events"
  class="w-screen h-screen overflow-y-scroll"
>
  {% for block in section.blocks %}
    <section
      id="event-{{ block.id }}"
      class="w-full sm:pt-80 min-h-screen flex flex-col-reverse flex-start items-start sm:flex-row reveal reveal-scale snap-start barista-button"
    >
      <!-- IMAGE -->
      <div class="sm:w-1/3 w-full flex justify-center sm:justify-start items-center">
        {% if block.settings.image != blank %}
          <div class="w-full sm:max-w-3xl sm:aspect-[4/5]">
            <img
              src="{{ block.settings.image | image_url: width: 2000 }}"
              alt="{{ block.settings.image_alt | escape }}"
              class="w-full object-contain"
            >
          </div>
        {% endif %}
      </div>

      <!-- TEXTE -->
      <div class="w-full sm:w-2/3 flex justify-start items-start ml-6">
        <div class="max-w-4xl">
          <div class="rte">
            {{ block.settings.text_html }}
          </div>
        </div>
      </div>
    </section>
  {% endfor %}
</section>

{% schema %}
{
  "name": "WB - Events",
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Titre interne (optionnel)",
      "default": "Nos events"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Event / Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Description image (accessibilité + SEO)"
        },
        {
          "type": "textarea",
          "id": "text_html",
          "label": "HTML personnalis\u00e9",
          "default": "<h2>Titre de l'event</h2>\\n<p>Texte ici…</p>"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "WB - Events",
      "blocks": [
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}

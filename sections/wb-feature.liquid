<section class="w-full sm:pt-80 min-h-screen flex flex-col-reverse flex-start items-start sm:flex-row reveal reveal-scale snap-start barista-button">

  <!-- IMAGE -->
  <div class="sm:w-1/3 w-full flex justify-center sm:justify-start items-center">
    {% if section.settings.image != blank %}
      <div class="w-full sm:max-w-3xl sm:aspect-[4/5]">
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          alt="{{ section.settings.image_alt | escape }}"
          class="w-full object-contain"
        >
      </div>
    {% endif %}
  </div>

  <!-- TEXTE -->
  <div class="w-full sm:w-2/3 flex justify-start items-start ml-6">
    <div class="max-w-4xl">
      <div class="rte">
        {{ section.settings.text_html }}
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "WB - Feature",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "description image : personnes malvoyantes et référencement"
    },
    {
      "type": "textarea",
      "id": "text_html",
      "label": "HTML personnalisé",
      "default": "<h2>Titre</h2>\n<p>Texte ici…</p>"
    }
  ],
  "presets": [
    {
      "name": "WB - Feature"
    }
  ]
}
{% endschema %}

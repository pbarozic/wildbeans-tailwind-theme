<section class="w-full min-h-screen flex flex-col md:flex-row items-stretch">

  <!-- IMAGE -->
  <div class="w-full md:w-1/2 flex justify-center items-center px-4 md:px-8 py-8 md:py-16">
    {% if section.settings.image != blank %}
      <div class="w-full max-w-xl aspect-[4/5]">
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image_alt | escape }}"
          class="w-full h-full object-contain"
        >
      </div>
    {% endif %}
  </div>

  <!-- TEXTE -->
  <div class="w-full md:flex-1 flex items-center px-4 md:px-8 py-8 md:py-16">
    <div class="w-full max-w-2xl mx-auto">
      <div class="rte">
        {% if section.settings.kicker != blank %}
          <p class="text-xs md:text-sm font-semibold tracking-[0.25em] mb-3 uppercase">
            {{ section.settings.kicker }}
          </p>
        {% endif %}

        {% if section.settings.title != blank %}
          <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold mb-4 leading-tight">
            {{ section.settings.title }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="text-base md:text-lg leading-relaxed space-y-4">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "WB - Feature",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Texte alternatif de l'image"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Petit titre (kicker)",
      "default": "Petit titre"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre principal",
      "default": "TITRE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Texte de description ici.</p>"
    }
  ],
  "presets": [
    {
      "name": "WB - Feature"
    }
  ]
}
{% endschema %}

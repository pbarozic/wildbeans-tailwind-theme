<section class="w-full pt-[380px] min-h-screen flex flex-col lg:flex-row lg:justify-center lg:items-start items-stretch reveal reveal-scale snap-start">

  <!-- IMAGE -->
  <div class="w-full lg:w-1/3 flex justify-center lg:justify-start items-center">
    {% if section.settings.image != blank %}
      <div class="w-full max-w-xl md:max-w-2xl lg:max-w-3xl aspect-[4/5] lg:aspect-[3/4]">
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          alt="{{ section.settings.image_alt | escape }}"
          class="w-full object-contain"
        >
      </div>
    {% endif %}
  </div>

  <!-- TEXTE -->
  <div class="w-full lg:w-2/3 lg:flex-1 flex justify-start items-start">
    <div class="max-w-4xl">
      <div class="rte">
        {{ section.settings.text_html }}
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "WB - Feature",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "description image : personnes malvoyantes et référencement"
    },
    {
      "type": "textarea",
      "id": "text_html",
      "label": "HTML personnalisé",
      "default": "<h2>Titre</h2>\n<p>Texte ici…</p>"
    }
  ],
  "presets": [
    {
      "name": "WB - Feature"
    }
  ]
}
{% endschema %}

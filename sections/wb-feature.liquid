<section class="w-full min-h-screen flex flex-col md:flex-row items-stretch">

  <!-- IMAGE -->
  <div class="w-full md:w-1/2 flex justify-center items-center px-4 md:px-8 py-8 md:py-16">
    {% if section.settings.image != blank %}
      <div class="w-full max-w-xl aspect-[4/5]">
        <img
          src="{{ section.settings.image | image_url: width: 1600 }}"
          alt="{{ section.settings.image_alt | escape }}"
          class="w-full h-full object-contain"
        >
      </div>
    {% endif %}
  </div>

  <!-- TEXTE -->
  <div class="w-full md:flex-1 flex items-center px-4 md:px-8 py-8 md:py-16">
    <div class="w-full max-w-2xl mx-auto">
      <div class="rte">
        {{ section.settings.text_html }}
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "WB - Feature",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "description image : personnes malvoyantes et référencement"
    },
    {
  "type": "textarea",
  "id": "text_html",
  "label": "HTML personnalisé",
  "default": "<h2>Titre</h2>\n<p>Texte ici…</p>"
}
  ],
  "presets": [
    {
      "name": "WB - Feature"
    }
  ]
}
{% endschema %}

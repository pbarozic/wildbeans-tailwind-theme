{%- liquid
  assign collection = section.settings.collection
-%}

<section
  id="coffee"
  class="w-full pt-80 pb-32 min-h-screen flex flex-col items-stretch reveal reveal-scale snap-start no-barista-button"
>
  <div class="px-6 flex flex-col items-start gap-8 h-full">

    {%- comment -%} TITRE + DESCRIPTION {%- endcomment -%}
    <div class="max-w-4xl">
      {% if section.settings.title != blank %}
        <h2 class="text-4xl font-semibold leading-tight">
          {{ section.settings.title }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="mt-4 text-base leading-relaxed rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    {%- comment -%} SLIDER HORIZONTAL PRODUITS {%- endcomment -%}
    {% if collection != blank and collection.products_count > 0 %}
      <div class="flex items-center">
        <div
          class="w-full flex justify-between overflow-x-auto md:snap-x md:snap-mandatory no-scrollbar pb-6"
        >
          {% for product in collection.products limit: section.settings.products_to_show %}
            {% render 'wb-card-product', card_product: product %}
          {% endfor %}
        </div>
      </div>
    {% else %}
      <p class="mt-8 text-sm opacity-70">
        Aucun produit à afficher dans cette sélection pour le moment.
      </p>
    {% endif %}

    {%- comment -%} BOUTON "VOIR TOUT" OPTIONNEL {%- endcomment -%}
    {% if section.settings.show_view_all and collection != blank %}
      <div class="mt-2">
        <a
          href="{{ collection.url }}"
          class="btn-wave inline-flex items-center text-xs tracking-[0.25em] uppercase font-semibold"
        >
          <span class="btn-wave-content inline-flex items-center gap-2">
            <span>{{ section.settings.view_all_label | default: 'VOIR TOUTE LA COLLECTION' }}</span>
            <span class="inline-block text-sm">↗</span>
          </span>
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  /* cacher la scrollbar horizontale mais garder le scroll */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

{% schema %}
{
  "name": "WB - Featured products",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Titre",
      "default": "OUR COFFEE SELECTION"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Une sélection de cafés Wild Beans pour vos moments les plus précieux.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Nombre de produits affichés"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Afficher le lien “Voir tout”",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texte du lien “Voir tout”",
      "default": "VOIR TOUTE LA COLLECTION"
    }
  ],
  "presets": [
    {
      "name": "WB - Featured products"
    }
  ]
}
{% endschema %}

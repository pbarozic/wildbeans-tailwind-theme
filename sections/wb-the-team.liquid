<style>
  .wb-letter {
    opacity: 0;
    transform: translateY(14px);
    display: inline-block;
    animation: wbFadeUp 0.9s forwards ease-out;
  }

  @keyframes wbFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

/* BASE */
/* BASE (PAS d'animation ici) */
.wb-chapter-btn{
  z-index: 999;
  pointer-events: auto;
  font-size: 14px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
}

/* HERO (vidéo) */
.wb-chapter-btn--hero{
  position: absolute;
  left: 50%;
  bottom: 28px;
  transform: translateX(-50%);
  color: white;

  /* blink uniquement ici */
  animation: wbBlink 1.4s infinite ease-in-out;
}

/* DARK (chapters) : caché par défaut */
.wb-chapter-btn--dark{
  position: fixed;
  left: 50%;
  bottom: 28px;
  transform: translateX(-50%);

  color: #111;

  padding: 10px 14px;
  border-radius: 999px;

  opacity: 0;
  pointer-events: none;
  transition: opacity 500ms cubic-bezier(0.19,1,0.22,1);

  /* surtout : pas d'animation tant que pas actif */
  animation: none;
}

/* quand actif : visible + blink */
.wb-chapter-btn--dark.is-active{
  opacity: 1;
  pointer-events: auto;

  animation: wbBlink 1.4s infinite ease-in-out;
}

@keyframes wbBlink{
  0%, 100% { opacity: 0.25; transform: translateX(-50%) translateY(0); }
  50%      { opacity: 1;    transform: translateX(-50%) translateY(-4px); }
}


</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  // =========================
  // HERO texte (vidéo)
  // =========================
  var titleText = "DISCOVER OUR STORY";
  var subtitleText = "A journey shaped by coffee, moments and people";
  var titleEl = document.getElementById("hero-title");
  var subtitleEl = document.getElementById("hero-subtitle");

  function animateText(el, text, baseDelay) {
    if (!el) return;
    el.innerHTML = "";
    Array.from(text).forEach(function (char, index) {
      var span = document.createElement("span");
      span.className = "wb-letter";
      span.textContent = char === " " ? "\u00A0" : char;
      span.style.animationDelay = (baseDelay + index * 0.08) + "s";
      el.appendChild(span);
    });
  }

  animateText(titleEl, titleText, 0.08);
  animateText(subtitleEl, subtitleText, 0.8);

  // =========================
  // Container scrollable
  // =========================
  var slider = document.getElementById("wild-beans-story-team");
  if (!slider) return;

  // =========================
  // Fade-in on scroll (ton observer)
  // =========================
  var fadeEls = document.querySelectorAll("[data-scroll-fade]");

  if (!("IntersectionObserver" in window)) {
    fadeEls.forEach(function (el) {
      el.classList.remove("opacity-0", "translate-y-6");
    });
    return;
  }

  var fadeObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      entry.target.classList.remove("opacity-0", "translate-y-6");
      entry.target.classList.add("opacity-100", "translate-y-0");
      fadeObserver.unobserve(entry.target);
    });
  }, {
    root: slider,
    threshold: 0.2
  });

  fadeEls.forEach(function (el) {
    fadeObserver.observe(el);
  });

  // =========================
  // CHAPTER buttons
  // =========================
  var map = {
    "#chapter-1": 1,
    "#chapter-2": 2,
    "#chapter-3": 3,
    "#chapter-4": 4,
    "#team": 5
  };

  // click handler (tous les boutons)
  document.querySelectorAll("[data-scroll-to]").forEach(function (btn) {
    btn.addEventListener("click", function (e) {
      e.preventDefault();
      if (typeof slider._goToSlide !== "function") return;

      var target = btn.getAttribute("data-scroll-to");
      if (map[target] !== undefined) slider._goToSlide(map[target]);
    });
  });

  // n'afficher qu'un seul bouton dark selon le chapitre visible
  var darkButtons = Array.from(document.querySelectorAll(".wb-chapter-btn--dark"));

  function setActiveDarkButton(btn) {
    darkButtons.forEach(function (b) {
      b.classList.remove("is-active");
    });
    if (btn) btn.classList.add("is-active");
  }

  // cache tout au départ
  setActiveDarkButton(null);

  var chapterSelectors = ["#chapter-1", "#chapter-2", "#chapter-3", "#chapter-4"];
  var chapterEls = chapterSelectors
    .map(function (sel) { return document.querySelector(sel); })
    .filter(Boolean);

  var chapterObserver = new IntersectionObserver(function (entries) {
    var visibleEntries = entries
      .filter(function (e) { return e.isIntersecting; })
      .sort(function (a, b) { return b.intersectionRatio - a.intersectionRatio; });

    var visible = visibleEntries[0];
    if (!visible) return;

    var btn = visible.target.querySelector(".wb-chapter-btn--dark");
    setActiveDarkButton(btn);
  }, {
    root: slider,
    threshold: [0.35, 0.5, 0.65]
  });

  chapterEls.forEach(function (el) {
    chapterObserver.observe(el);
  });
});
</script>



{%- comment -%}
  Carte produit simplifiée Wild Beans
  Utilisation :
  {% render 'wb-card-product', card_product: product %}
{%- endcomment -%}

{% assign product = card_product | default: product %}

{% if product %}
  <a
    href="{{ product.url }}"
    class="flex flex-col items-start 
           w-[70%] sm:w-[50%] md:w-[35%] lg:w-[28%] xl:w-[22%]
           flex-shrink-0 snap-start group"
  >
    {% if product.featured_image %}
      <div class="w-full aspect-[4/5] overflow-hidden mb-4">
        <img
          srcset="
            {{ product.featured_image | image_url: width: 360 }} 360w,
            {{ product.featured_image | image_url: width: 533 }} 533w,
            {{ product.featured_image | image_url: width: 720 }} 720w,
            {{ product.featured_image | image_url: width: 940 }} 940w
          "
          src="{{ product.featured_image | image_url: width: 533 }}"
          sizes="(min-width: 1024px) 25vw, 50vw"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          loading="lazy"
        >
      </div>
    {% endif %}

    <h3 class="text-xl font-semibold mb-1">
      {{ product.title }}
    </h3>

    <p class="text-lg">
      {{ product.price | money }}
    </p>
  </a>
{% endif %}

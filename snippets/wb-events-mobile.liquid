{% comment %}
  WB — Events (Mobile) — Dawn native / ultra simple
  - HERO title/subtitle (letters)
  - 3 events en scroll normal + scroll-snap (snap en haut de chaque event)
  - reveal via Dawn: .scroll-trigger + .animate--slide-in
{% endcomment %}

<section class="sm:hidden uppercase w-full px-5 pt-6 pb-6">
  <div class="mx-auto max-w-screen-sm">
    <h1 id="events-mobile-title"
        class="mt-2 text-5xl font-extrabold leading-tight tracking-tight text-black"></h1>

    <p id="events-mobile-subtitle"
       class="mt-2 text-2xl leading-snug text-black/80"></p>
  </div>
</section>


<section id="wb-events-mobile" class="sm:hidden uppercase w-full px-5">
  <div class="mx-auto max-w-screen-sm wb-events-snap">

    <!-- EVENT 1 -->
    <section class="wb-event snap-start scroll-trigger animate--slide-in">
      <h2 class="text-xl font-extrabold leading-tight" >
        A designed coffee experience
      </h2>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        Together we elevate your event with a bespoke coffee experience.
      </p>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        Wild Beans is a <strong>nomad barista service</strong> with a high-end barista station,
        a unique design crafted to improve the coffee service. From small gatherings,
        committee or corporate meetings to large-scale conventions, shootings or fashion shows.
        We <strong>adapt our service</strong> to all kinds of events.
      </p>

      <p class="mt-2 text-base font-semibold leading-snug scroll-trigger animate--slide-in">
        Our products &amp; coffee menu.
      </p>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        We are selecting our own coffee, working with amongst
        <strong>the best roasters</strong> in Paris, France &amp; Europe to source beans that
        reflect the essence of Wild Beans.
      </p>

      <div class="mt-4 overflow-hidden shadow-lg scroll-trigger animate--slide-in">
        <img
          src="{{ 'BBW_BARISTOSS_12396_1.jpg' | file_url }}"
          alt="A designed coffee experience"
          loading="lazy"
          class="block w-full aspect-[4/3] object-cover">
      </div>
    </section>

    <!-- EVENT 2 -->
    <section class="wb-event">
      <h2 class="text-xl font-extrabold leading-tight scroll-trigger animate--slide-in">
        Beyond coffee
      </h2>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        We also provide a <strong>variety of coffee-free drinks</strong>, crafted with care and creativity:
        matcha, hojicha, chai, hot chocolate, sesame, ube, or our <strong>seasonal lattes</strong>.
      </p>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        All drinks can be served <strong>hot or iced</strong>, with your choice of milk or plant-based alternatives:
        <strong>oat, coconut, almond, soy.</strong>
      </p>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        Looking for a personal touch? We can create custom latte art using our special printer,
        allowing you to add your own branding or unique designs to your drinks.
      </p>

      <p class="mt-2 text-base font-semibold leading-snug scroll-trigger animate--slide-in">
        Don’t see your favorite drink on the menu?
        <strong>Tell us, and we’ll make it just for you!</strong>
      </p>

      <div class="mt-4 overflow-hidden shadow-lg scroll-trigger animate--slide-in">
        <img
          src="{{ 'WILD_BEANS_021882.jpg' | file_url }}"
          alt="Beyond coffee"
          loading="lazy"
          class="block w-full aspect-[4/3] object-cover">
      </div>
    </section>

    <!-- EVENT 3 -->
    <section class="wb-event">
      <h2 class="text-xl font-extrabold leading-tight scroll-trigger animate--slide-in">
        Wild Beans touch
      </h2>

      <h3 class="mt-3 text-lg font-extrabold leading-tight scroll-trigger animate--slide-in">
        Our barista experts
      </h3>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        We work with a team of experienced and renowned baristas throughout France.
        Beyond latte art, it’s about coffee knowledge, storytelling, and machine expertise.
      </p>

      <h3 class="mt-3 text-lg font-extrabold leading-tight scroll-trigger animate--slide-in">
        Signature coffee stations
      </h3>

      <p class="mt-2 text-base leading-snug scroll-trigger animate--slide-in">
        We designed unique coffee stations made of stainless steel to improve the barista service
        on any location. Our solution is plug &amp; play — we bring everything.
      </p>

      <div class="mt-4 overflow-hidden shadow-lg scroll-trigger animate--slide-in">
        <img
          src="{{ 'BBW_BARISTOSS_12452_1.jpg' | file_url }}"
          alt="Wild Beans touch"
          loading="lazy"
          class="block w-full aspect-[4/3] object-cover">
      </div>
    </section>

  </div>
<!-- CTA FIXED (GLOBAL) -->
<div class="fixed bottom-20 right-10 z-[99999]">
  <a href="/pages/contact"
     class="inline-flex items-center justify-center gap-2
            border border-black bg-black px-5 py-3
            text-xs font-extrabold uppercase tracking-widest text-white shadow-lg">
    Book your barista <span aria-hidden="true">↗</span>
  </a>
</div>

</section>



<style>
  /* letters */
  .wb-letter{
    opacity:0;
    transform:translateY(14px);
    display:inline-block;
    animation: wbFadeUp 1s forwards ease-out;
  }
  @keyframes wbFadeUp { to { opacity:1; transform:translateY(0);} }

  /* snap: "auto vers le haut de chaque event" (sans JS) */
  #wb-events-mobile .wb-events-snap{
    scroll-snap-type: y proximity;
  }
  #wb-events-mobile .wb-event{
    scroll-snap-align: start;
    /* évite que le header cache l'event */
    scroll-margin-top: calc(var(--header-height, 80px) + 16px);
    padding-top: 16px;
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(0,0,0,.1);
  }
  #wb-events-mobile .wb-event:last-child{ border-bottom: 0; }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var titleEl = document.getElementById("events-mobile-title");
    var subtitleEl = document.getElementById("events-mobile-subtitle");
    if (!titleEl || !subtitleEl) return;

    var titleText = "ELEVATE YOUR EVENTS";
    var subtitleText = "Where Premium Coffee Meets Flawless Service";

    function animateText(el, text, baseDelay, speed) {
      el.innerHTML = "";
      Array.from(text).forEach(function (char, index) {
        var span = document.createElement("span");
        span.className = "wb-letter";
        span.textContent = char === " " ? "\u00A0" : char;
        span.style.animationDelay = (baseDelay + index * speed) + "s";
        el.appendChild(span);
      });
    }

    animateText(titleEl, titleText, 0.08, 0.08);
    animateText(subtitleEl, subtitleText, 0.8, 0.05);
  });
</script>
